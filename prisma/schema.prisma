// A Ripples Effect — Tap Water & Microplastics Database Schema
// Inspired by EWG Tap Water Database + 2026 Water Project microplastics mission

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// A public water utility / system (PWS). One utility serves one or more ZIP codes.
model Utility {
  id              String   @id @default(cuid())
  pwsid           String   @unique // EPA Public Water System ID (e.g. "IL0316040")
  name            String
  city            String
  state           String
  zipCodes        String   // comma separated list, e.g. "60601,60602"
  county          String?
  population      Int      @default(0)
  systemType      String   @default("Community") // Community / Non-Community / etc.
  sourceType      String   @default("Surface")   // Surface / Ground / Mixed
  treatmentStatus String   @default("Treated")   // Treated / Untreated / Mixed
  latitude        Float?
  longitude       Float?
  website         String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  samples         Sample[]
  reports         Report[]
  alertSubs       AlertSubscription[]

  @@index([state])
  @@index([city])
}

// Master catalog of contaminants measured in drinking water.
// Includes both regulated contaminants and emerging ones like microplastics.
model Contaminant {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  chemicalName    String?
  category        String   // Microplastic / Disinfection Byproduct / Metal / Pesticide / PFAS / Microbial / Other
  legalLimit      Float?   // EPA MCL in same unit as measurement; null = unregulated
  legalLimitUnit  String?  // e.g. "ppb", "ppm", "particles/L"
  healthGuideline Float?   // EWG / WHO health guideline (often stricter than legal limit)
  healthGuidelineUnit String?
  ewgHealthLimit  Float?   // EWG's own health reference
  description     String?
  healthEffects   String?  // long form
  sources         String?  // where it comes from
  regulated       Boolean  @default(true)
  trackedByUs     Boolean  @default(false) // true = A Ripples Effect actively tracks this (most sites don't)
  rarityNote      String?  // short note on how rare tracking this is
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  samples         Sample[]
  alertSubs       AlertSubscription[]
}

// A single measurement of one contaminant at one utility on one date.
model Sample {
  id            String   @id @default(cuid())
  utilityId     String?
  contaminantId String
  level         Float    // measured value
  unit          String   // particles/L, ppb, ppm
  sampleDate    DateTime
  source        String   @default("Utility CCR") // Utility CCR / Citizen Test / Research Lab / EWG
  treatmentStatus String @default("Treated") // Treated / Untreated (lets us compare)
  location      String?  // tap, stream, reservoir, treatment plant outflow...
  quality       String   @default("verified") // verified / provisional / citizen
  notes         String?
  createdAt     DateTime @default(now())

  utility       Utility?     @relation(fields: [utilityId], references: [id], onDelete: Cascade)
  contaminant   Contaminant @relation(fields: [contaminantId], references: [id], onDelete: Cascade)

  @@index([utilityId])
  @@index([contaminantId])
  @@index([sampleDate])
  @@index([quality])
}

// Community-submitted water observations. Anyone can submit one (no login required).
model Report {
  id          String   @id @default(cuid())
  utilityId   String?
  reporterName String?
  reporterEmail String?
  zipCode     String
  city        String?
  state       String?
  title       String
  description String
  contaminant String?  // free text - what they noticed
  appearance  String?  // cloudy / discolored / odor / taste / normal
  severity    String   @default("info") // info / warning / critical
  status      String   @default("pending") // pending / reviewed / resolved
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  utility     Utility? @relation(fields: [utilityId], references: [id], onDelete: SetNull)

  @@index([zipCode])
  @@index([status])
}

// Admin / staff accounts for managing data.
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String   // hashed
  role      String   @default("admin") // admin / editor / viewer
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions  Session[]
}

// Admin login sessions.
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([expiresAt])
}

// Chapter signups — people who take the microplastics identifier and test
// their own local water streams, then push data into this database.
model Chapter {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  chapterName String?  // name they want for their local chapter
  city        String?
  state       String?
  zipCode     String?
  waterBody   String?  // the stream/river/lake/tap they plan to test
  organization String? // school, club, or community org (optional)
  identifier  Boolean  @default(false) // do they need us to ship an identifier?
  message     String?
  status      String   @default("pending") // pending / contacted / onboarded / active / declined
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}

// Keep legacy Volunteer table for backwards compat with existing API code
model Volunteer {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  zipCode   String?
  city      String?
  state     String?
  role      String   @default("Chapter Lead")
  skills    String?
  availability String?
  message   String?
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([role])
}

// Email alert subscriptions. Users sign up to be notified when a specific
// utility's contaminant levels exceed a health guideline threshold.
model AlertSubscription {
  id          String   @id @default(cuid())
  email       String
  utilityId   String?
  zipCode     String?
  contaminantId String? // null = all contaminants
  threshold   Float?   // custom threshold; null = use health guideline
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  utility     Utility?     @relation(fields: [utilityId], references: [id], onDelete: Cascade)
  contaminant Contaminant? @relation(fields: [contaminantId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([utilityId])
  @@index([active])
}

// Donations — crowdfunding-style. Public submission (no payment processing yet;
// links to external GoFundMe). We record intent + optional message so the crew
// can thank donors and track momentum.
model Donation {
  id        String   @id @default(cuid())
  name      String
  email     String?
  amount    Float    // pledged amount in USD
  tier      String   @default("Supporter") // Supporter / Friend / Champion / Founding
  message   String?
  anonymous Boolean  @default(false)
  status    String   @default("pledged") // pledged / completed
  createdAt DateTime @default(now())

  @@index([status])
  @@index([tier])
}
