# Local dev: point these at your own Postgres instance, or a free Neon database.
# On Netlify, both keys need to be set in Site settings -> Environment
# variables (this .env file is gitignored and never gets deployed).
# DATABASE_URL = Neon's "pooled" connection string (used at runtime)
# DIRECT_URL   = Neon's "direct" connection string (used for db push/migrations)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"
